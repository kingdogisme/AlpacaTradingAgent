# TradingAgents Environment Configuration
# ======================================
# Instructions:
# 1. Copy this file to ".env".
# 2. Replace placeholder values with your own keys.
# 3. Restart the CLI/WebUI after changing this file.
#
# Keep ALPACA_USE_PAPER=True while testing. Set it to False only when you
# intentionally want live Alpaca trading.


# ---------------------------------------------------------------------------
# Runtime Paths
# ---------------------------------------------------------------------------

# Optional. Defaults to "eval_results".
TRADINGAGENTS_RESULTS_DIR=eval_results

# Optional. Defaults to tradingagents/dataflows/data_cache.
TRADINGAGENTS_CACHE_DIR=tradingagents/dataflows/data_cache

# Optional. Defaults to ~/.tradingagents/memory/trading_memory.md.
TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md

# Optional. Defaults to ~/.tradingagents/eval/agent_eval.sqlite.
TRADINGAGENTS_EPISODE_LEDGER_PATH=~/.tradingagents/eval/agent_eval.sqlite

# Optional. Defaults to ~/.tradingagents/trade_lifecycle/trade_lifecycle.sqlite.
TRADINGAGENTS_TRADE_LIFECYCLE_DB_PATH=~/.tradingagents/trade_lifecycle/trade_lifecycle.sqlite

# Optional. Override selected bundled model prompt templates with Markdown files.
# Keep grouped paths, for example analysts/market_system.md.
# Missing files fall back to tradingagents/prompts/templates.
TRADINGAGENTS_PROMPT_DIR=


# ---------------------------------------------------------------------------
# Portfolio Policy
# ---------------------------------------------------------------------------

# trend_concentrated allows same-theme concentration when trend, relative
# strength, catalyst durability, and invalidation are aligned. Use diversified
# if you want conventional balanced sizing.
TRADINGAGENTS_PORTFOLIO_STYLE=trend_concentrated

# Target number of active names in the basket. The default trend-concentrated
# policy assumes a smaller 5-ticket basket rather than an equal-weight
# 10-ticket portfolio.
TRADINGAGENTS_TARGET_TICKET_COUNT=5


# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------

# Supported values:
# openai, local_openai, google, anthropic, xai, deepseek, qwen, glm,
# openrouter, ollama, azure
LLM_PROVIDER=openai


# ---------------------------------------------------------------------------
# OpenAI and Local OpenAI-Compatible Endpoints
# ---------------------------------------------------------------------------

# Required for OpenAI models and OpenAI web-search data tools.
# Also used by memory embeddings unless OPENAI_USE_LOCAL points embeddings to
# a compatible local endpoint.
OPENAI_API_KEY=your_openai_api_key_here

# Set true to route core LLM and embedding calls to OPENAI_BASE_URL.
# OpenAI web-search tools still require OPENAI_API_KEY because local endpoints
# usually do not support OpenAI Responses web search.
OPENAI_USE_LOCAL=false

# Examples:
# LM Studio: http://localhost:1234/v1
# Ollama OpenAI compatibility: http://localhost:11434/v1
# vLLM OpenAI server: http://localhost:8000/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional embedding model override for memory.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Optional reflection-memory embedding backend.
# Use "google" when the local OpenAI-compatible proxy does not expose
# POST /v1/embeddings.
# Supported values: openai, google, gemini, disabled.
TRADINGAGENTS_EMBEDDING_PROVIDER=openai
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001


# ---------------------------------------------------------------------------
# Non-OpenAI LLM Providers
# ---------------------------------------------------------------------------

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok
XAI_API_KEY=your_xai_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alibaba Qwen via DashScope OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama does not require an API key by default. Use backend_url in the UI/CLI
# or OPENAI_BASE_URL with LLM_PROVIDER=local_openai for OpenAI compatibility.


# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-12-01-preview


# ---------------------------------------------------------------------------
# Trading, Market Data, News, and Macro APIs
# ---------------------------------------------------------------------------

# Alpaca is required for market data and optional order execution.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_USE_PAPER=True

# Optional execution broker routing. Keep alpaca for the existing paper executor,
# set robinhood as default after MCP OAuth login, or override per order with
# trade-plan-execute --broker <name>.
TRADINGAGENTS_BROKER_ADAPTER=alpaca

# Optional Robinhood trading MCP integration.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN_PATH=~/.tradingagents/robinhood/oauth_token.json
ROBINHOOD_MCP_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
ROBINHOOD_ACCOUNT_NUMBER=
ROBINHOOD_MCP_DRY_RUN=true
ROBINHOOD_MCP_LIVE_ORDERS_ENABLED=false
ROBINHOOD_MCP_TIMEOUT_SECONDS=20

# Finnhub is used for equity news, insider sentiment/transactions, and
# earnings calendar data.
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED is used by the macro analyst.
FRED_API_KEY=your_fred_api_key_here

# CryptoCompare/CoinDesk-compatible news source used for crypto analysis.
COINDESK_API_KEY=your_cryptocompare_api_key_here

# Optional Alpha Vantage MCP fundamentals source.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional but recommended for SEC EDGAR official filing facts.
# Use a descriptive app/contact string to satisfy SEC fair-access guidance.
SEC_EDGAR_USER_AGENT=AlpacaTradingAgent research your_email@example.com
TRADINGAGENTS_SEC_EDGAR_METRIC_STALE_DAYS=540
TRADINGAGENTS_FINNHUB_FUNDAMENTALS_METRIC_STALE_DAYS=540

# Alpha Discovery confirmation freshness guards. Stale or undated news should
# not promote a candidate into A-list; old price/volume bars should not confirm.
TRADINGAGENTS_ALPHA_DISCOVERY_NEWS_CONFIRMATION_MAX_AGE_DAYS=14
TRADINGAGENTS_ALPHA_DISCOVERY_REQUIRE_NEWS_CONFIRMATION_DATE=true
TRADINGAGENTS_ALPHA_DISCOVERY_PRICE_VOLUME_MAX_BAR_AGE_DAYS=5

# OpenAI web-search data-source policy.
# fallback = prefer SEC/Finnhub/SellTheNews/FRED/etc. and bind OpenAI only when
# no fast non-OpenAI source is available. eager restores old behavior.
TRADINGAGENTS_POINT_IN_TIME_SOURCE_POLICY=auto
TRADINGAGENTS_OPENAI_SOURCES_POLICY=fallback
TRADINGAGENTS_OPENAI_SOURCE_CALL_BUDGET_PER_RUN=1
TRADINGAGENTS_OPENAI_SOURCE_TIMEOUT_SECONDS=25
TRADINGAGENTS_SKIP_OPENAI_WHEN_NON_OPENAI_SUFFICIENT=true
TRADINGAGENTS_NON_OPENAI_SUFFICIENCY_MIN_CHARS=1200

# Optional SellTheNews MCP options-positioning source.
# The runtime config defaults this off. Enable in code/UI config with:
# sellthenews_options_enabled=True
